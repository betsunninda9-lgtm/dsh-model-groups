{
  "name": "dsh-model-groups",
  "version": "0.3.6",
  "description": "DSH 网页模型选择器：供应商与密钥配置分层折叠、多密钥独立协议与安全直升维护。支持 DSH 0.2.2-rc.1。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betsunninda9-lgtm/dsh-model-groups.git"
  },
  "homepage": "https://github.com/betsunninda9-lgtm/dsh-model-groups#readme",
  "bugs": {
    "url": "https://github.com/betsunninda9-lgtm/dsh-model-groups/issues"
  },
  "keywords": ["dsh", "deepseek-harness", "models", "multi-key", "model-picker"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "native/*.patch.json",
    "scripts",
    "!scripts/settings-models-collapse.mjs",
    "!scripts/pi-ai-protocol.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "external": [
        "react",
        "react-dom",
        "react/jsx-runtime",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:build": "node scripts/build.mjs --check",
    "test": "node --test test/*.test.mjs",
    "test:ui": "node --test test/picker-ui.test.mjs",
    "native:check": "node scripts/native-patches.mjs --check",
    "doctor": "node scripts/doctor.mjs",
    "prepack": "npm run build && npm run check:build"
  }
}
