{
  "name": "dsh-model-groups",
  "version": "0.4.0-alpha.15",
  "description": "在 DSH 原模型界面管理独立密钥、协议和模型；自动接入统一编辑器，通过公开 LLM 服务分流。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betsunninda9-lgtm/dsh-model-groups.git"
  },
  "homepage": "https://github.com/betsunninda9-lgtm/dsh-model-groups#readme",
  "bugs": {
    "url": "https://github.com/betsunninda9-lgtm/dsh-model-groups/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "models",
    "multi-key",
    "model-picker"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./lib/bridge-host-0.4.0-alpha.15.js",
  "exports": {
    ".": "./lib/bridge-host-0.4.0-alpha.15.js",
    "./client": "./lib/client.js",
    "./bridge": "./lib/bridge-host-0.4.0-alpha.15.js",
    "./bridge/*": "./lib/bridge-host-*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "native/*.patch.json",
    "scripts",
    "!scripts/settings-models-collapse.mjs",
    "!scripts/pi-ai-protocol.mjs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "docs/maintenance.md",
    "docs/provider-editor-interface-proposal.md",
    "docs/unified-models-feasibility.md",
    "docs/capabilities-beta.md",
    "docs/images/*.webp",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "external": [
        "react",
        "react-dom",
        "react/jsx-runtime",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:build": "node scripts/build.mjs --check",
    "test": "node --test test/*.test.mjs",
    "test:ui": "node --test test/picker-ui.test.mjs",
    "native:check": "node scripts/native-patches.mjs --check",
    "doctor": "node scripts/doctor.mjs",
    "prepack": "npm run build && npm run check:build"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "acorn": "^8.15.0"
  }
}
